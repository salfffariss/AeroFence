<Window x:Class="AeroFence.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AeroFence Setup"
        Width="500" Height="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="12"
            Background="#E610141D"
            BorderBrush="#4038BDF8"
            BorderThickness="1.5"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.6" Direction="270" Color="#000000" />
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <!-- Titlebar / Header -->
                <RowDefinition Height="Auto" />
                <!-- Hero Branding -->
                <RowDefinition Height="Auto" />
                <!-- Options & Path -->
                <RowDefinition Height="*" />
                <!-- Progress bar -->
                <RowDefinition Height="Auto" />
                <!-- Actions -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom Clean Titlebar -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/app.png" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Text="AeroFence Setup Wizard" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="26" Height="26" Background="Transparent" BorderThickness="0"
                        Foreground="#94A3B8" Cursor="Hand" Click="CloseButton_Click">
                    <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>

            <!-- Hero Branding -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Border Width="64" Height="64" CornerRadius="16" Background="#2038BDF8" BorderBrush="#5038BDF8" BorderThickness="1"
                        HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Image Source="Assets/app.png" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="AeroFence v1.0" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="Fluent Frosted Glass Desktop Organizer for Windows 11" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Install Options -->
            <StackPanel Grid.Row="2" VerticalAlignment="Top">
                <TextBlock Text="Destination Folder:" Foreground="#CBD5E1" FontSize="12" FontWeight="Medium" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathTextBox" Grid.Column="0" Height="30" Padding="8,4"
                             Background="#20000000" Foreground="#F8FAFC" BorderBrush="#40FFFFFF" BorderThickness="1"
                             FontSize="11" VerticalContentAlignment="Center" IsReadOnly="True" />
                    <Button Grid.Column="1" Content="Browse..." Height="30" Padding="12,0" Margin="6,0,0,0"
                            Background="#2538BDF8" Foreground="#F8FAFC" BorderBrush="#5038BDF8" BorderThickness="1"
                            FontSize="11" Cursor="Hand" Click="BrowseButton_Click" />
                </Grid>

                <CheckBox x:Name="StartupCheckBox" IsChecked="True" Content="Run automatically when Windows starts" 
                          Foreground="#F8FAFC" FontSize="12" Margin="0,0,0,8" Cursor="Hand" />
                <CheckBox x:Name="StartMenuCheckBox" IsChecked="True" Content="Create Start Menu shortcut" 
                          Foreground="#F8FAFC" FontSize="12" Margin="0,0,0,8" Cursor="Hand" />
                <CheckBox x:Name="DesktopCheckBox" IsChecked="True" Content="Create Desktop shortcut" 
                          Foreground="#F8FAFC" FontSize="12" Margin="0,0,0,8" Cursor="Hand" />
            </StackPanel>

            <!-- Progress Bar & Status Text -->
            <StackPanel Grid.Row="3" Margin="0,10,0,10">
                <TextBlock x:Name="StatusTextBlock" Text="Ready to install" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4" />
                <ProgressBar x:Name="InstallProgressBar" Height="6" Minimum="0" Maximum="100" Value="0"
                             Foreground="#38BDF8" Background="#20FFFFFF" BorderThickness="0" />
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="4" Margin="0,8,0,0">
                <Button x:Name="CancelBtn" Content="Cancel" HorizontalAlignment="Left" Width="90" Height="32"
                        Background="Transparent" Foreground="#94A3B8" BorderBrush="#30FFFFFF" BorderThickness="1"
                        Cursor="Hand" Click="CloseButton_Click" />

                <Button x:Name="InstallBtn" Content="Install Now" HorizontalAlignment="Right" Width="130" Height="32"
                        Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold"
                        Cursor="Hand" Click="InstallBtn_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#38BDF8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
