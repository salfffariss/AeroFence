<UserControl x:Class="AeroFence.Views.ItemCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:AeroFence.Models"
             xmlns:converters="clr-namespace:AeroFence.Converters"
             mc:Ignorable="d"
             Focusable="True"
             d:DataContext="{d:DesignInstance Type=models:ItemModel}">

    <UserControl.Resources>
        <converters:PathToIconConverter x:Key="PathToIconConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Border x:Name="CardBorder"
            CornerRadius="6"
            Padding="4,6"
            Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
            Cursor="Hand"
            AllowDrop="True"
            PreviewMouseLeftButtonDown="CardBorder_PreviewMouseLeftButtonDown"
            PreviewMouseMove="CardBorder_PreviewMouseMove"
            PreviewMouseLeftButtonUp="CardBorder_PreviewMouseLeftButtonUp"
            PreviewMouseRightButtonDown="CardBorder_PreviewMouseRightButtonDown"
            DragEnter="CardBorder_DragEnter"
            DragLeave="CardBorder_DragLeave"
            DragOver="CardBorder_DragOver"
            Drop="CardBorder_Drop">

        <!-- Tooltip: Clean stats with dynamic runtime status -->
        <Border.ToolTip>
            <ToolTip Background="#E6141418"
                     BorderBrush="#38FFFFFF"
                     BorderThickness="1"
                     Padding="8,6"
                     HasDropShadow="True">
                <ToolTip.Template>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                    <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Currently Running" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="⏱️ Playtime: " 
                                               FontSize="11" 
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Stats.FormattedPlaytime}" 
                                               FontSize="11" 
                                               FontWeight="SemiBold" 
                                               Foreground="{StaticResource AccentBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚀 Launches: " 
                                               FontSize="11" 
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Stats.LaunchCount, StringFormat='{}{0} times'}" 
                                               FontSize="11" 
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </ToolTip.Template>
            </ToolTip>
        </Border.ToolTip>

        <!-- Right-Click Context Menu -->
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Open" FontWeight="SemiBold"
                          Click="OpenMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🚀" FontSize="12" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Rename"
                          Click="RenameMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="✏️" FontSize="12" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open file location"
                          Click="OpenLocationMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📂" FontSize="12" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open in Terminal"
                          Click="OpenInTerminalMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="💻" FontSize="12" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Background="#22FFFFFF" Margin="4,2" />
                <MenuItem Header="Remove from Fence"
                          Click="RemoveMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🗑️" FontSize="12" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>

        <!-- Dynamic Visual States for Default, Hover, and Selected -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Opacity" Value="1.0" />
                <Style.Triggers>
                    <!-- Dimmed state during Type-to-Filter Search -->
                    <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                        <Setter Property="Opacity" Value="0.22" />
                    </DataTrigger>

                    <!-- Best Match Highlight during Search -->
                    <DataTrigger Binding="{Binding IsBestMatch}" Value="True">
                        <Setter Property="Background" Value="#2838BDF8" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="1.5" />
                    </DataTrigger>

                    <!-- Currently Running (Emerald glow) -->
                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="BorderBrush" Value="#8810B981" />
                        <Setter Property="Background" Value="#1A10B981" />
                    </DataTrigger>

                    <!-- Hover (Unselected) -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                            <Condition Binding="{Binding IsSelected}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#1CFFFFFF" />
                        <Setter Property="BorderBrush" Value="#25FFFFFF" />
                    </MultiDataTrigger>

                    <!-- Selected -->
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="#2E38BDF8" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="1.5" />
                    </DataTrigger>

                    <!-- Hover while Selected -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                            <Condition Binding="{Binding IsSelected}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#4438BDF8" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <!-- Drop target indicator (glows when another card is dragged over this card) -->
            <Border x:Name="DropIndicator"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="2"
                    CornerRadius="6"
                    Background="#2538BDF8"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Margin="-3,-4" />

            <StackPanel HorizontalAlignment="Center">
                <!-- Native Windows Shell Extracted Icon -->
                <Border Width="{Binding DataContext.IconContainerSize, RelativeSource={RelativeSource AncestorType=Window}}"
                        Height="{Binding DataContext.IconContainerSize, RelativeSource={RelativeSource AncestorType=Window}}" 
                        Background="Transparent" 
                        CornerRadius="8" 
                        HorizontalAlignment="Center"
                        Margin="0,0,0,6">
                    <Grid>
                        <!-- Fallback Glyph if path not found -->
                        <TextBlock Text="📁" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3" />
                        <!-- High-Res Native Shell Icon -->
                        <Image Source="{Binding Converter={StaticResource PathToIconConverter}}" 
                               Width="{Binding DataContext.IconPixelSize, RelativeSource={RelativeSource AncestorType=Window}}"
                               Height="{Binding DataContext.IconPixelSize, RelativeSource={RelativeSource AncestorType=Window}}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Running Indicator Badge (Steam style) -->
                <Border Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center"
                        Margin="0,-2,0,4"
                        Background="#2610B981"
                        BorderBrush="#10B981"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="5,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="#10B981" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="RUNNING" FontSize="8.5" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Display Name (View Mode) -->
                <TextBlock Text="{Binding DisplayName}"
                           Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}"
                           FontSize="{Binding DataContext.TextFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="{Binding DataContext.TextMaxWidth, RelativeSource={RelativeSource AncestorType=Window}}" />

                <!-- Inline Rename Mode: TextBox -->
                <TextBox x:Name="ItemRenameTextBox"
                         Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                         FontSize="{Binding DataContext.TextFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                         FontWeight="Medium"
                         Background="#50000000"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource AccentBrush}"
                         BorderThickness="1"
                         Padding="3,1"
                         MinWidth="60"
                         MaxWidth="{Binding DataContext.TextMaxWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                         TextAlignment="Center"
                         HorizontalAlignment="Center"
                         KeyDown="ItemRenameTextBox_KeyDown"
                         LostFocus="ItemRenameTextBox_LostFocus"
                         IsVisibleChanged="ItemRenameTextBox_IsVisibleChanged" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
