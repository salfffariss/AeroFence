<Window x:Class="AeroFence.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AeroFence.ViewModels"
        xmlns:models="clr-namespace:AeroFence.Models"
        mc:Ignorable="d"
        Title="AeroFence Settings"
        Height="540" Width="800"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/Assets/app.ico"
        FontFamily="{StaticResource FluentFontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Nav Tab Button Style -->
        <Style x:Key="NavTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="navBorder"
                                CornerRadius="6"
                                Padding="12,0"
                                Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#18FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#2538BDF8" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings Card Container Style -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <!-- Outer Acrylic Window Frame -->
    <Border Background="#F012141A"
            BorderBrush="{StaticResource AcrylicBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <!-- TitleBar Header (36px) -->
                <RowDefinition Height="36" />
                <!-- Content Area -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Settings TitleBar -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="/Assets/app.png" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="AeroFence Dashboard &amp; Settings" 
                               FontSize="12.5" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Close Button -->
                <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        ToolTip="Close Settings"
                        Click="CloseButton_Click">
                    <TextBlock Text="✕" FontSize="11" />
                </Button>

                <!-- Bottom border line -->
                <Border VerticalAlignment="Bottom" Height="1" Background="#15FFFFFF" />
            </Grid>

            <!-- Main Body Split-View -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Left Sidebar (210px) -->
                    <ColumnDefinition Width="210" />
                    <!-- Right Content (Fill) -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar Navigation -->
                <Border Grid.Column="0" 
                        Background="#0AFFFFFF" 
                        BorderBrush="#15FFFFFF" 
                        BorderThickness="0,0,1,0"
                        Padding="10,12">
                    <StackPanel>
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavTabButtonStyle}" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="General &amp; Startup" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavAppearance" Style="{StaticResource NavTabButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎨" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="Appearance &amp; Blur" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavFences" Style="{StaticResource NavTabButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="Fences Manager" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavChameleon" Style="{StaticResource NavTabButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🦎" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="Chameleon™ Mode" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavShortcuts" Style="{StaticResource NavTabButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌨️" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="Shortcuts &amp; Gestures" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavTabButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ️" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="About &amp; Statistics" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Right Content Pane -->
                <ScrollViewer Grid.Column="1" 
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,18">
                    <Grid>
                        <!-- PAGE 1: General & Startup -->
                        <StackPanel Visibility="{Binding IsChecked, ElementName=NavGeneral, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="General Settings" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Configure Windows startup, desktop pinning, and core behaviors." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />

                            <!-- Card 1: Start with Windows -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="Start AeroFence with Windows" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Automatically launches desktop fences in the background on system boot." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource FluentToggleSwitch}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding Config.StartWithWindows}"
                                              Click="StartWithWindows_Click" />
                                </Grid>
                            </Border>

                            <!-- Card 2: Pin to Desktop (WorkerW Wallpaper Layer) -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="Pin to Desktop Layer (Wallpaper)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Keeps fences permanently docked behind active windows (survives Win+D Show Desktop)." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource FluentToggleSwitch}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding Config.AttachToDesktop}"
                                              Click="AttachToDesktop_Click" />
                                </Grid>
                            </Border>

                            <!-- Card 3: Desktop Right-Drag Fence Creation -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="Desktop Right-Drag Fence Creation" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Draw a rectangular selection with the right mouse button on desktop wallpaper to create a new fence." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="Enabled" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- PAGE 2: Appearance & Blur -->
                        <StackPanel Visibility="{Binding IsChecked, ElementName=NavAppearance, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Appearance &amp; Aero Glass" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Personalize transparency, backdrop blur, and visual styling." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />

                            <!-- Card 1: Hardware Acrylic Blur -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="Windows 11 Hardware Acrylic Blur" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Renders GPU-accelerated translucent acrylic glass effect." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource FluentToggleSwitch}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding Config.EnableAcrylic}"
                                              Click="AcrylicToggle_Click" />
                                </Grid>
                            </Border>

                            <!-- Card 2: Icon Size Options -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Default Icon Size" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Select the display scale for application shortcuts." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Small (24px)" Padding="8,4" Margin="0,0,4,0" 
                                                Command="{Binding SetIconSizeCommand}" 
                                                CommandParameter="{x:Static models:IconSizeOption.Small}" />
                                        <Button Content="Medium (36px)" Padding="8,4" Margin="0,0,4,0" 
                                                Command="{Binding SetIconSizeCommand}" 
                                                CommandParameter="{x:Static models:IconSizeOption.Medium}" />
                                        <Button Content="Large (48px)" Padding="8,4" 
                                                Command="{Binding SetIconSizeCommand}" 
                                                CommandParameter="{x:Static models:IconSizeOption.Large}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- PAGE 3: Fences Manager -->
                        <StackPanel Visibility="{Binding IsChecked, ElementName=NavFences, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Fences Manager" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="Manage active fences or create new containers on your desktop." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="📁 Create Folder Portal" 
                                            Padding="10,6" Margin="0,0,8,0"
                                            FontWeight="SemiBold"
                                            Click="CreateFolderPortal_Click" />
                                    <Button Content="➕ Create New Fence" 
                                            Padding="10,6" 
                                            FontWeight="SemiBold"
                                            Click="CreateFence_Click" />
                                </StackPanel>
                            </Grid>

                            <!-- List of Active Fences -->
                            <ItemsControl x:Name="FencesListItemsControl" ItemsSource="{Binding Config.Fences}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:FenceModel}">
                                        <Border Style="{StaticResource SettingsCardStyle}">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,160,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <Border Background="#2538BDF8" CornerRadius="3" Padding="5,1" Margin="8,0,0,0"
                                                                Visibility="{Binding IsFolderPortal, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Folder Portal" FontSize="10" Foreground="#38BDF8" FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Tabs.Count, StringFormat='{}{0} Tab(s)'}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Content="🎯 Focus" 
                                                            Padding="8,4" Margin="0,0,6,0"
                                                            Tag="{Binding}"
                                                            Click="FocusFence_Click"
                                                            ToolTip="Bring this fence to front on your desktop" />

                                                    <Button Content="🗑️ Delete" 
                                                            Padding="8,4"
                                                            Background="#30EF4444"
                                                            BorderBrush="#80EF4444"
                                                            Foreground="#FCA5A5"
                                                            Tag="{Binding}"
                                                            Click="DeleteFence_Click"
                                                            ToolTip="Delete this fence container" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- PAGE 4: Chameleon Mode -->
                        <StackPanel Visibility="{Binding IsChecked, ElementName=NavChameleon, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Chameleon™ Mode" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Blend your fences into the wallpaper for a peaceful, distraction-free desktop." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />

                            <!-- Card 1: Enable Chameleon -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="Enable Chameleon™ Blending" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Fades out fences and icons to semi-transparent when the mouse is away, revealing wallpaper." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource FluentToggleSwitch}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding Config.EnableChameleon}"
                                              Click="ChameleonToggle_Click" />
                                </Grid>
                            </Border>

                            <!-- Card 2: Inactive Fade Level Slider -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                                        <TextBlock Text="Inactive Opacity Level" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Set how faint the fence becomes when not in focus." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Slider Width="100" Minimum="0.15" Maximum="0.80" Value="{Binding Config.ChameleonOpacity}" ValueChanged="ChameleonOpacity_ValueChanged" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Config.ChameleonOpacity, StringFormat='{}{0:P0}'}" FontSize="12" Width="40" TextAlignment="Right" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- PAGE 5: Shortcuts & Gestures -->
                        <StackPanel Visibility="{Binding IsChecked, ElementName=NavShortcuts, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Shortcuts &amp; Gestures Guide" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Master AeroFence navigation and interaction shortcuts." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <TextBlock Text="Inline Rename" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Select item / tab &amp; press F2 (or Right-Click → Rename)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <TextBlock Text="Roll-Up / Expand" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Double-click anywhere on the TitleBar" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <TextBlock Text="Type-to-Filter Search" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Type letters while fence is active (Enter to launch, Esc to clear)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <TextBlock Text="Draw New Fence" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Hold Right Mouse Button &amp; drag a box on desktop wallpaper" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <TextBlock Text="Keyboard Navigation" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Use Arrow keys (← ↑ → ↓) to navigate across items" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- PAGE 6: About & Statistics -->
                        <StackPanel Visibility="{Binding IsChecked, ElementName=NavAbout, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="About AeroFence" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="High-performance lightweight desktop organization for Windows 11." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Image Source="/Assets/app.png" Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="AeroFence v1.0.0" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="Built with .NET 9 + C# + Windows 11 DWM Native Acrylic Blur." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                    <TextBlock Text="Portable architecture: Zero Windows Registry tampering (except optional user startup)." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
