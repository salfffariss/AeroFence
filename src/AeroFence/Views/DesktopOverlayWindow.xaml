<Window x:Class="AeroFence.Views.DesktopOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AeroFence Desktop Selection"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Canvas x:Name="RootCanvas" Background="#01000000"
            MouseLeftButtonDown="RootCanvas_MouseLeftButtonDown"
            MouseRightButtonDown="RootCanvas_MouseRightButtonDown">

        <!-- Live Selection Box -->
        <Border x:Name="SelectionBox"
                Visibility="Collapsed"
                BorderThickness="1.5"
                BorderBrush="#38BDF8"
                Background="#2538BDF8"
                CornerRadius="6"
                SnapsToDevicePixels="True"
                IsHitTestVisible="False">
            <!-- Dimensions Badge (e.g. 480 × 320) -->
            <Border x:Name="BadgeContainer"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,8,8"
                    CornerRadius="4"
                    Background="#DD111827"
                    Padding="6,3"
                    SnapsToDevicePixels="True">
                <TextBlock x:Name="DimensionBadge"
                           Foreground="#F8FAFC"
                           FontSize="11"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI, sans-serif"
                           Text="420 × 280" />
            </Border>
        </Border>

        <!-- Fences 5 Proximity Action Pill -->
        <Border x:Name="ActionPill"
                Visibility="Collapsed"
                CornerRadius="8"
                Background="#F2181822"
                BorderBrush="#8038BDF8"
                BorderThickness="1"
                Padding="6,4"
                SnapsToDevicePixels="True"
                MouseLeftButtonDown="ActionPill_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.55" Direction="270" Color="#000000" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Create Fence Button -->
                <Button x:Name="CreateFenceBtn" Click="CreateFenceBtn_Click"
                        Background="#2538BDF8" BorderBrush="#8038BDF8" BorderThickness="1"
                        Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold"
                        Padding="10,6" Margin="0,0,4,0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="6" 
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#38BDF8" />
                                    <TextBlock Text="Create Fence" VerticalAlignment="Center" FontFamily="Segoe UI, sans-serif" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#4538BDF8" />
                                    <Setter TargetName="b" Property="BorderBrush" Value="#38BDF8" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#7038BDF8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Create Folder Portal Button -->
                <Button x:Name="CreatePortalBtn" Click="CreatePortalBtn_Click"
                        Background="#2010B981" BorderBrush="#8010B981" BorderThickness="1"
                        Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold"
                        Padding="10,6" Margin="0,0,4,0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="pb" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="6" 
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Folder Portal" VerticalAlignment="Center" FontFamily="Segoe UI, sans-serif" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="pb" Property="Background" Value="#4510B981" />
                                    <Setter TargetName="pb" Property="BorderBrush" Value="#10B981" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="pb" Property="Background" Value="#7010B981" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Cancel Button -->
                <Button x:Name="CancelBtn" Click="CancelBtn_Click" Margin="2,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#94A3B8" FontSize="13" Width="26" Height="26" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="cb" Background="{TemplateBinding Background}" CornerRadius="5">
                                <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI, sans-serif" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cb" Property="Background" Value="#30FFFFFF" />
                                    <Setter Property="Foreground" Value="#F8FAFC" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
